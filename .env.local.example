# Copie este arquivo para .env.local e preencha com as chaves do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# URL pública da aplicação (usada nos links de recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Necessária APENAS para rodar `npm run import:taco` (importação da base TACO).
# NUNCA use esta chave no navegador — ela ignora RLS. Encontre-a em
# Project Settings > API > service_role, no painel do Supabase.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Sentry (monitoramento de erros). A DSN não é segredo — só identifica o projeto.
NEXT_PUBLIC_SENTRY_DSN=https://3ac92ff0bf9a33927407ba479f720581@o4512131005284352.ingest.us.sentry.io/4512131091660800
# Apenas no build de produção (Netlify), para enviar source maps. É segredo —
# gere em Sentry > Settings > Auth Tokens. Não precisa localmente.
# SENTRY_AUTH_TOKEN=
